{
  "name": "@k3_2o/pi-chrollo",
  "version": "0.2.0",
  "description": "Retrieval layer over Pi's native sessions — ripgrep + JSONL, zero own storage",
  "keywords": [
    "pi-package",
    "memory",
    "agent"
  ],
  "author": "k3_2o",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k3-2o/pi-chrollo.git"
  },
  "scripts": {
    "format": "prettier --write 'index.ts' 'src/*.ts'",
    "format:check": "prettier --check 'index.ts' 'src/*.ts'",
    "smoke": "tsx -e \"import './index'; import './src/tokenize'; import './src/bm25'; console.log('OK')\"",
    "check": "npm run format:check && npm run smoke"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@earendil-works/pi-tui": "^0.80.10",
    "@types/node": "^26.1.1",
    "prettier": "^3.5.3",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
